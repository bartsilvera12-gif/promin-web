<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" type="image/png" href="/symbol.png">
<title>ProMin · Panel admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F4F6F8; --card:#FFFFFF; --soft:#F8FAFC; --line:#E4E8EE; --line2:#EDF0F4;
    --txt:#141B2D; --muted:#6B7280; --dim:#9AA3AF;
    --brand:#DE694E; --brand-dark:#C9563C; --primary:#141B2D; --primary-h:#1E2740;
    --ok:#149a63; --err:#c33;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%}
  body{background:var(--bg);color:var(--txt);font-family:'Sora',sans-serif;font-size:15px;-webkit-font-smoothing:antialiased}
  a{color:var(--brand);text-decoration:none}
  ::selection{background:var(--brand);color:#fff}
  .mono{font-family:'JetBrains Mono',monospace}
  button{font-family:inherit;cursor:pointer}
  input,textarea,select{font-family:inherit}

  /* ============ LOGIN ============ */
  .login{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;padding:24px;background:var(--bg)}
  .login-card{background:var(--card);border:1px solid var(--line);border-radius:20px;box-shadow:0 20px 60px rgba(20,27,45,.08);width:100%;max-width:410px;padding:44px 40px}
  .login-logo{display:flex;justify-content:center;margin-bottom:22px}
  .login-logo img{height:30px}
  .login-card h1{text-align:center;font-size:27px;font-weight:800;letter-spacing:-.6px;margin:0 0 4px}
  .login-card .brandline{text-align:center;color:var(--muted);font-size:14px;margin-bottom:30px}
  .lbl{display:block;font-size:13px;font-weight:600;color:var(--txt);margin:0 0 8px}
  .inp{width:100%;background:var(--card);border:1px solid var(--line);border-radius:12px;padding:13px 15px;color:var(--txt);font-size:14.5px;transition:border-color .18s,box-shadow .18s}
  .inp::placeholder{color:var(--dim)}
  .inp:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px rgba(222,105,78,.14)}
  .login .field{margin-bottom:18px}
  .btn-primary{display:flex;align-items:center;justify-content:center;gap:9px;width:100%;background:var(--primary);color:#fff;border:0;border-radius:12px;padding:14px;font-size:15px;font-weight:600;transition:background .2s,transform .12s}
  .btn-primary:hover{background:var(--primary-h)}
  .btn-primary:active{transform:translateY(1px)}
  .login .foot{text-align:center;color:var(--dim);font-size:12.5px;margin-top:20px;line-height:1.5}
  .login .err{color:var(--err);font-size:13px;text-align:center;min-height:18px;margin-top:6px}

  /* ============ APP SHELL ============ */
  .app{display:none;grid-template-columns:248px 1fr;min-height:100vh}
  .side{background:var(--card);border-right:1px solid var(--line);padding:20px 14px;position:sticky;top:0;height:100vh;overflow:auto}
  .side .logo{display:flex;align-items:center;gap:10px;padding:6px 10px 4px}
  .side .logo img{height:24px}
  .side .role{font-size:11px;color:var(--dim);padding:2px 10px 18px;letter-spacing:.3px}
  .navsep{font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:var(--dim);padding:16px 12px 8px;font-weight:600}
  .navbtn{display:flex;align-items:center;gap:12px;width:100%;text-align:left;background:none;border:0;color:var(--muted);padding:10px 12px;border-radius:10px;font-size:14px;font-weight:500;transition:background .16s,color .16s;margin-bottom:2px}
  .navbtn:hover{background:var(--soft);color:var(--txt)}
  .navbtn.active{background:rgba(222,105,78,.10);color:var(--brand-dark);font-weight:600}
  .navbtn .ic{width:18px;text-align:center;font-size:15px;opacity:.9}

  .main{display:flex;flex-direction:column;min-width:0}
  .topbar{position:sticky;top:0;z-index:10;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:15px 30px;background:rgba(244,246,248,.9);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);flex-wrap:wrap}
  .topbar h1{font-size:19px;font-weight:700;margin:0;letter-spacing:-.3px}
  .topbar .sub{font-size:12.5px;color:var(--dim);margin-top:2px}
  .actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .content{padding:26px 30px 90px;max-width:1000px;width:100%}

  .lang{display:inline-flex;border:1px solid var(--line);border-radius:999px;overflow:hidden;background:var(--card)}
  .lang button{background:none;border:0;color:var(--muted);padding:7px 15px;font-size:12px;font-weight:600}
  .lang button.on{background:var(--primary);color:#fff}

  .btn{display:inline-flex;align-items:center;gap:8px;border:1px solid var(--line);background:var(--card);color:var(--txt);padding:9px 15px;border-radius:10px;font-size:13.5px;font-weight:600;transition:border-color .18s,background .18s,transform .12s}
  .btn:hover{background:var(--soft);border-color:#D4DAE2}
  .btn:active{transform:translateY(1px)}
  .btn.primary{background:var(--primary);border-color:var(--primary);color:#fff}
  .btn.primary:hover{background:var(--primary-h)}
  .btn.accent{background:var(--brand);border-color:var(--brand);color:#fff}
  .btn.accent:hover{background:var(--brand-dark)}
  .btn.ghost{background:none}
  .btn.sm{padding:7px 12px;font-size:12.5px}
  .btn.danger{color:#b0402c}
  .btn.danger:hover{background:#fbeeea;border-color:#f0cabd}

  .grid{display:grid;gap:16px}
  .stats{grid-template-columns:repeat(auto-fit,minmax(180px,1fr))}
  .tile{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:22px 24px}
  .tile .k{font-size:12px;color:var(--dim);text-transform:uppercase;letter-spacing:.6px;font-weight:600}
  .tile .v{font-size:36px;font-weight:800;color:var(--txt);line-height:1;margin-top:12px;letter-spacing:-1px}
  .tile .d{font-size:13px;color:var(--muted);margin-top:8px}
  .tile .v span{color:var(--brand)}

  .card{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:24px 26px;margin-bottom:18px}
  .card h3{margin:0 0 4px;font-size:16px;font-weight:700}
  .card .hint{font-size:13px;color:var(--dim);margin:0 0 18px}
  .field{margin-bottom:16px}
  .field:last-child{margin-bottom:0}
  .field label{display:block;font-size:12px;letter-spacing:.3px;color:var(--muted);margin-bottom:7px;font-weight:600}
  .field .flag{font-size:10px;color:var(--brand);margin-left:6px;font-weight:700}
  input[type=text],textarea,select{width:100%;background:var(--soft);border:1px solid var(--line);border-radius:10px;padding:11px 13px;color:var(--txt);font-size:14px;transition:border-color .18s,box-shadow .18s}
  input[type=text]:focus,textarea:focus,select:focus{outline:none;border-color:var(--brand);box-shadow:0 0 0 3px rgba(222,105,78,.12);background:var(--card)}
  textarea{resize:vertical;min-height:78px;line-height:1.5}

  .item{background:var(--soft);border:1px solid var(--line);border-radius:14px;padding:18px 20px;margin-bottom:14px}
  .item .ihead{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:14px}
  .item .ihead .idx{font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--brand);font-weight:600}
  .chips-input{display:flex;flex-wrap:wrap;gap:7px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:10px;padding:8px 10px}
  .chip{display:inline-flex;align-items:center;gap:7px;font-size:12.5px;background:rgba(222,105,78,.10);border:1px solid rgba(222,105,78,.28);color:var(--brand-dark);padding:4px 10px;border-radius:999px}
  .chip button{background:none;border:0;color:var(--brand);font-size:14px;line-height:1;padding:0}
  .chips-input input{flex:1;min-width:90px;background:none;border:0;color:var(--txt);padding:4px;font-size:13px}
  .chips-input input:focus{outline:none;box-shadow:none}

  .savebar{position:fixed;left:248px;right:0;bottom:0;display:flex;align-items:center;justify-content:space-between;gap:14px;padding:13px 30px;background:var(--card);border-top:1px solid var(--line);box-shadow:0 -8px 24px rgba(20,27,45,.06);transform:translateY(130%);transition:transform .3s ease;z-index:20}
  .savebar.show{transform:translateY(0)}
  .savebar .msg{font-size:13px;color:var(--muted)}
  .dot{width:8px;height:8px;border-radius:50%;background:var(--brand);display:inline-block;margin-right:8px}

  .toast{position:fixed;top:18px;left:50%;transform:translateX(-50%) translateY(-30px);background:var(--txt);color:#fff;border-radius:10px;padding:12px 20px;font-size:13.5px;opacity:0;transition:opacity .3s,transform .3s;z-index:50;box-shadow:0 14px 40px rgba(20,27,45,.25)}
  .toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

  .overlay{position:fixed;inset:0;background:rgba(20,27,45,.45);-webkit-backdrop-filter:blur(3px);backdrop-filter:blur(3px);display:none;align-items:center;justify-content:center;padding:24px;z-index:60}
  .overlay.show{display:flex}
  .modal{background:var(--card);border-radius:18px;max-width:560px;width:100%;padding:30px;box-shadow:0 30px 80px rgba(20,27,45,.25)}
  .modal h2{margin:0 0 8px;font-size:20px}
  .modal p,.modal ol{color:var(--muted);line-height:1.6;font-size:14px}
  .modal ol{padding-left:20px}
  .modal code{background:var(--soft);border:1px solid var(--line);border-radius:6px;padding:2px 7px;font-family:'JetBrains Mono',monospace;font-size:12.5px;color:var(--brand-dark)}

  /* ============ IMÁGENES ============ */
  .imgrid{grid-template-columns:repeat(auto-fill,minmax(280px,1fr))}
  .imgcard{background:var(--card);border:1px solid var(--line);border-radius:16px;overflow:hidden;display:flex;flex-direction:column}
  .imgcard .thumb{position:relative;aspect-ratio:16/10;background:var(--soft) center/cover no-repeat;border-bottom:1px solid var(--line2)}
  .imgcard .thumb.logo{background-size:contain;background-repeat:no-repeat;background-position:center;background-color:#141B2D}
  .imgcard .body{padding:14px 16px 16px}
  .imgcard .nm{font-size:14.5px;font-weight:700;margin:0}
  .imgcard .wh{font-size:12px;color:var(--dim);margin:2px 0 12px}
  .imgcard .st{font-size:12px;min-height:16px;margin-top:9px}
  .imgcard .st.ok{color:var(--ok)} .imgcard .st.err{color:var(--err)} .imgcard .st.busy{color:var(--muted)}
  .imgcard.up .thumb::after{content:"";position:absolute;inset:0;background:rgba(255,255,255,.55)}
  .imgbadge{position:absolute;top:8px;left:8px;font-size:10.5px;font-weight:700;letter-spacing:.4px;padding:3px 8px;border-radius:999px;background:rgba(20,27,45,.72);color:#fff}
  .galcard{transition:box-shadow .15s,opacity .15s}
  .galcard[draggable=true]{cursor:grab}
  .galcard.dragging{opacity:.4;outline:2px dashed var(--brand);outline-offset:2px}
  .galcard.hidden .thumb{filter:grayscale(1) opacity(.6)}
  .galcard .galf{width:100%;box-sizing:border-box;font:inherit;font-size:13px;padding:7px 9px;border:1px solid var(--line);border-radius:9px;background:var(--card);color:var(--txt)}
  .galcard .galf:focus{outline:none;border-color:var(--brand)}
  .galcard textarea.galf{min-height:52px;resize:vertical}
  .galcard .galchk{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--muted);white-space:nowrap}
  .galrow{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
  .menutoggle{display:none}
  @media (max-width:820px){
    .app{grid-template-columns:1fr}
    .side{position:fixed;left:0;top:0;bottom:0;z-index:40;transform:translateX(-100%);transition:transform .3s;width:248px}
    .side.open{transform:translateX(0)}
    .savebar{left:0}
    .menutoggle{display:inline-flex!important}
  }
</style>
</head>
<body>

<!-- ============ LOGIN ============ -->
<div class="login" id="login">
  <div class="login-card">
    <div class="login-logo"><img src="/logo-full.png" alt="ProMin"></div>
    <h1>Panel admin</h1>
    <div class="brandline">ProMin Consultoria</div>
    <div class="field">
      <label class="lbl" for="email">Email</label>
      <input class="inp" type="text" id="email" autocomplete="username" placeholder="tu@email.com" onkeydown="if(event.key==='Enter')document.getElementById('pass').focus()">
    </div>
    <div class="field">
      <label class="lbl" for="pass">Contraseña</label>
      <input class="inp" type="password" id="pass" autocomplete="current-password" placeholder="••••••••" onkeydown="if(event.key==='Enter')doLogin()">
    </div>
    <button class="btn-primary" onclick="doLogin()">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
      Ingresar
    </button>
    <div class="err" id="loginErr"></div>
    <div class="foot" id="loginFoot">Acceso restringido al equipo de ProMin / Neura.</div>
  </div>
</div>

<!-- ============ APP ============ -->
<div class="app" id="app">
  <aside class="side" id="side">
    <div class="logo"><img src="/logo-full.png" alt="ProMin"></div>
    <div class="role" id="roleLine">Panel admin</div>
    <div class="navsep">Gestión</div>
    <nav id="nav"></nav>
    <div class="navsep">Acciones</div>
    <button class="navbtn" onclick="doExport()"><span class="ic">↧</span> Exportar JSON</button>
    <button class="navbtn" onclick="document.getElementById('importfile').click()"><span class="ic">↥</span> Importar JSON</button>
    <button class="navbtn" onclick="openPublish()"><span class="ic">◈</span> Cómo publicar</button>
    <button class="navbtn" onclick="doReset()"><span class="ic">⟲</span> Restaurar</button>
    <button class="navbtn" onclick="logout()" style="color:#b0402c"><span class="ic">⏻</span> Cerrar sesión</button>
    <input type="file" id="importfile" accept="application/json" style="display:none" onchange="doImport(event)">
  </aside>

  <main class="main">
    <div class="topbar">
      <div style="display:flex;align-items:center;gap:14px">
        <button class="btn ghost sm menutoggle" onclick="document.getElementById('side').classList.toggle('open')">☰</button>
        <div>
          <h1 id="pageTitle">Dashboard</h1>
          <div class="sub" id="pageSub">Resumen del contenido del sitio</div>
        </div>
      </div>
      <div class="actions">
        <div class="lang" id="langSwitch">
          <button data-l="pt" class="on" onclick="setLang('pt')">PT</button>
          <button data-l="es" onclick="setLang('es')">ES</button>
        </div>
        <a class="btn ghost sm" href="/Inicio.dc.html" target="_blank">Ver sitio ↗</a>
      </div>
    </div>
    <div class="content" id="content"></div>
  </main>
</div>

<div class="savebar" id="savebar">
  <div class="msg"><span class="dot"></span><span id="saveMsg">Tienes cambios sin guardar.</span></div>
  <div style="display:flex;gap:10px">
    <button class="btn ghost sm" onclick="discardChanges()">Descartar</button>
    <button class="btn accent sm" onclick="saveAll()">Guardar cambios</button>
  </div>
</div>

<div class="toast" id="toast"></div>

<div class="overlay" id="publishModal">
  <div class="modal">
    <h2>Cómo publicar los cambios</h2>
    <p>El panel guarda los <b>textos</b> en este navegador (para publicarlos hace falta conectarlos, lo puede dejar listo Neura). En cambio las <b>imágenes</b> sí se suben al servidor y se ven en vivo (<span class="mono">prominconsultoria.com</span>) al instante.</p>
    <ol>
      <li><b>Exportar</b> el contenido con <code>Exportar JSON</code> y aplicarlo al sitio.</li>
      <li>Conectar las páginas a <code>content.json</code> (lo puede dejar listo Neura): así, al subir el JSON exportado, el sitio se actualiza solo.</li>
    </ol>
    <p style="margin-top:14px">Para un panel con <b>login real y base de datos</b> (como una tienda con Supabase), hace falta conectar un backend — Neura puede montarlo.</p>
    <div style="text-align:right;margin-top:20px"><button class="btn primary" onclick="closePublish()">Entendido</button></div>
  </div>
</div>

<script>
/* ============================ AUTH (sesión real en el servidor: api/gallery.php) ============================
   La contraseña NO vive en el JavaScript: se valida en el servidor y ahí queda la sesión
   que autoriza las escrituras de la galería (subir/editar/reordenar/eliminar). */
const GAL_API = '/api/gallery.php';
function doLogin(){
  const err = document.getElementById('loginErr');
  const em  = document.getElementById('email').value.trim();
  const pw  = document.getElementById('pass').value;
  err.textContent = '';
  if(!em || !pw){ err.textContent = 'Ingresá tu email y contraseña.'; return; }
  const btn = document.querySelector('#login .btn.primary'); if(btn){ btn.disabled=true; btn.dataset.t=btn.textContent; btn.textContent='Ingresando…'; }
  const fd = new FormData(); fd.append('action','login'); fd.append('pass',pw);
  fetch(GAL_API, { method:'POST', body:fd, credentials:'same-origin' })
    .then(r=>r.json())
    .then(res=>{
      if(res && res.ok){ sessionStorage.setItem('promin_admin_ok','1'); showApp(); }
      else { err.textContent = 'Email o contraseña incorrectos.'; }
    })
    .catch(()=>{ err.textContent = 'No se pudo conectar con el servidor. Reintentá en unos segundos.'; })
    .finally(()=>{ if(btn){ btn.disabled=false; btn.textContent=btn.dataset.t||'Ingresar'; } });
}
function logout(){
  sessionStorage.removeItem('promin_admin_ok');
  const fd=new FormData(); fd.append('action','logout');
  fetch(GAL_API,{method:'POST',body:fd,credentials:'same-origin'}).catch(()=>{}).finally(()=>location.reload());
}
function showApp(){
  document.getElementById('login').style.display='none';
  document.getElementById('app').style.display='grid';
  buildNav(); go('dashboard');
}

/* ============================ CONTENT MODEL ============================ */
const STORE_KEY = 'promin_content_v1';
const DEFAULT = {
  site: { brand:'ProMin', region:'BR/PR', phone:'+55 31 97207-5744', email:'prominconsultoria@gmail.com', whatsapp:'5531972075744' },
  hero: {
    eyebrow_pt:'Consultoria em Mineração — BR/PR', eyebrow_es:'Consultoría en Minería — BR/PR',
    title_pt:'Expertise para mineirar do jeito certo.', title_es:'Expertise para minar de la forma correcta.',
    lede_pt:'Há mais de 20 anos entregando soluções técnicas de alta qualidade para operações de mineração e pedreiras — com visão estratégica, eficiência e compromisso.',
    lede_es:'Desde hace más de 20 años entregando soluciones técnicas de alta calidad para operaciones de minería y canteras — con visión estratégica, eficiencia y compromiso.',
    cta1_pt:'Conheça a ProMin', cta1_es:'Conoce ProMin', cta2_pt:'Nossos serviços', cta2_es:'Nuestros servicios',
  },
  about: {
    kicker_pt:'Sobre a ProMin', kicker_es:'Sobre ProMin',
    title_pt:'Referência em consultoria para mineração e pedreiras.', title_es:'Referencia en consultoría para minería y canteras.',
    lead_pt:'A ProMin é uma consultoria especializada em oferecer soluções personalizadas para o setor de mineração e pedreiras.',
    lead_es:'ProMin es una consultoría especializada en ofrecer soluciones personalizadas para el sector de la minería y las canteras.',
    body_pt:'Combinamos conhecimento técnico profundo, tradição e uma abordagem moderna para identificar as melhores oportunidades e impulsionar o sucesso dos nossos clientes — sempre com ética, qualidade e excelência no atendimento.',
    body_es:'Combinamos conocimiento técnico profundo, tradición y un enfoque moderno para identificar las mejores oportunidades e impulsar el éxito de nuestros clientes — siempre con ética, calidad y excelencia en la atención.',
  },
  stats: [
    { n:'+20', l_pt:'anos de expertise no setor', l_es:'años de expertise en el sector' },
    { n:'04', l_pt:'áreas de atuação', l_es:'áreas de actuación' },
    { n:'BR·PR', l_pt:'atuação com alcance nacional', l_es:'actuación con alcance nacional' },
  ],
  values: [
    { title_pt:'Confiança', title_es:'Confianza', desc_pt:'Relações de parceria construídas com transparência.', desc_es:'Relaciones de colaboración construidas con transparencia.' },
    { title_pt:'Eficiência', title_es:'Eficiencia', desc_pt:'Processos que otimizam operações e maximizam resultados.', desc_es:'Procesos que optimizan operaciones y maximizan resultados.' },
    { title_pt:'Excelência', title_es:'Excelencia', desc_pt:'Cada projeto executado com respeito aos padrões do setor.', desc_es:'Cada proyecto ejecutado respetando los estándares del sector.' },
  ],
  services: [
    { title_pt:'Consultoria Técnica', title_es:'Consultoría Técnica', desc_pt:'Diagnóstico e orientação especializada para elevar a performance da operação.', desc_es:'Diagnóstico y orientación especializada para elevar el desempeño de la operación.' },
    { title_pt:'Produção & Logística', title_es:'Producción & Logística', desc_pt:'Planejamento que resolve gargalos e otimiza o fluxo da operação.', desc_es:'Planificación que resuelve cuellos de botella y optimiza el flujo.' },
    { title_pt:'Gestão de Manutenção', title_es:'Gestión de Mantenimiento', desc_pt:'Disponibilidade de máquinas e equipamentos, com menos paradas.', desc_es:'Disponibilidad de máquinas y equipos, con menos paradas.' },
    { title_pt:'Extração & Comercialização', title_es:'Extracción & Comercialización', desc_pt:'Domínio dos processos de extração e do mercado de minerais.', desc_es:'Dominio de los procesos de extracción y del mercado de minerales.' },
    { title_pt:'Assessoria de Negócios', title_es:'Asesoría de Negocios', desc_pt:'Suporte técnico e estratégico para projetos de mineração.', desc_es:'Soporte técnico y estratégico para proyectos de minería.' },

    { tag_pt:'CARVÃO', tag_es:'CARBÓN', title_pt:'Carvão Mineral', title_es:'Carbón Mineral', desc_pt:'Suporte técnico em operações de carvão, da extração à comercialização.', desc_es:'Soporte técnico en operaciones de carbón, de la extracción a la comercialización.', items_pt:['Extração','Estoque','Comercialização'], items_es:['Extracción','Almacenaje','Comercialización'] },

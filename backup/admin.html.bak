let data = load(), draft = clone(data), lang = 'pt', current = 'dashboard', dirty = false;
function clone(o){ return JSON.parse(JSON.stringify(o)); }
function load(){ try{ const raw=localStorage.getItem(STORE_KEY); if(raw) return Object.assign(clone(DEFAULT),JSON.parse(raw)); }catch(e){} return clone(DEFAULT); }
function persist(){ draft._meta=draft._meta||{}; draft._meta.savedAt=new Date().toISOString(); data=clone(draft); try{ localStorage.setItem(STORE_KEY,JSON.stringify(data)); }catch(e){ alert('No se pudo guardar.'); } }

function buildNav(){
  let html = '<button class="navbtn" data-p="dashboard" onclick="go(\'dashboard\')"><span class="ic">▦</span> Dashboard</button>';
  html += '<button class="navbtn" data-p="images" onclick="go(\'images\')"><span class="ic">▣</span> Imágenes</button>';
  html += '<button class="navbtn" data-p="gallery" onclick="go(\'gallery\')"><span class="ic">▤</span> Galería</button>';
  SCHEMA.forEach(s => html += `<button class="navbtn" data-p="${s.id}" onclick="go('${s.id}')"><span class="ic">${s.icon}</span> ${s.label}</button>`);
  document.getElementById('nav').innerHTML = html;
}
function setActiveNav(){ document.querySelectorAll('.navbtn[data-p]').forEach(b=>b.classList.toggle('active',b.getAttribute('data-p')===current)); }
function setLang(l){ lang=l; document.querySelectorAll('#langSwitch button').forEach(b=>b.classList.toggle('on',b.getAttribute('data-l')===l)); if(current!=='dashboard') go(current); }
function esc(s){ return (s==null?'':String(s)).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

function go(id){
  current=id; document.getElementById('side').classList.remove('open'); setActiveNav();
  const c=document.getElementById('content');
  if(id==='dashboard'){ renderDashboard(c); return; }
  if(id==='images'){
    document.getElementById('pageTitle').textContent='Imágenes';
    document.getElementById('pageSub').textContent='Reemplazá las imágenes del sitio';
    renderImages(c); window.scrollTo(0,0); return;
  }
  if(id==='gallery'){
    document.getElementById('pageTitle').textContent='Galería';
    document.getElementById('pageSub').textContent='Agregá o quitá fotos por servicio';
    renderGallery(c); window.scrollTo(0,0); return;
  }
  const s=SCHEMA.find(x=>x.id===id);
  document.getElementById('pageTitle').textContent=s.title;
  document.getElementById('pageSub').textContent=s.sub;
  s.type==='object' ? renderObject(c,s) : renderList(c,s);
  window.scrollTo(0,0);
}
function renderDashboard(c){
  document.getElementById('pageTitle').textContent='Dashboard';
  document.getElementById('pageSub').textContent='Resumen del contenido del sitio';
  const savedAt = data._meta && data._meta.savedAt ? new Date(data._meta.savedAt).toLocaleString('es') : 'Nunca';
  const tiles=[
    {k:'Servicios',v:data.services.length,d:'servicios publicados'},
    {k:'Áreas',v:data.areas.length,d:'áreas de actuación'},
    {k:'Proceso',v:data.process.length,d:'pasos del método'},
    {k:'Valores',v:data.values.length,d:'pilares de marca'},
    {k:'Idiomas',v:2,d:'PT · ES'},
  ];
  let html=`<div class="grid stats" style="margin-bottom:22px">`;
  tiles.forEach(t=>html+=`<div class="tile"><div class="k">${t.k}</div><div class="v">${t.v}</div><div class="d">${t.d}</div></div>`);
  html+=`</div>`;
  html+=`<div class="card"><h3>Acciones rápidas</h3><p class="hint">Empieza a editar cualquier sección o gestiona el contenido.</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap">
      <button class="btn accent" onclick="go('hero')">Editar portada</button>
      <button class="btn" onclick="go('services')">Editar servicios</button>
      <button class="btn" onclick="go('contact')">Editar contacto</button>
      <button class="btn ghost" onclick="doExport()">↧ Exportar respaldo</button>
    </div></div>`;
  html+=`<div class="card"><h3>Estado</h3>
    <div class="field" style="margin:0"><label>Último guardado</label><div class="mono" style="color:var(--muted);font-size:13px">${savedAt}</div></div>
    <div class="field" style="margin-top:14px"><label>Sitio en vivo</label><a class="mono" style="font-size:13px" href="https://prominconsultoria.com/" target="_blank">prominconsultoria.com ↗</a></div></div>`;
  html+=`<div class="card" style="border-color:rgba(222,105,78,.3);background:#FCF3F0"><h3>ℹ Cómo se guardan los cambios</h3>
    <p class="hint" style="margin:0;line-height:1.6;color:var(--muted)">Todo lo que edites se guarda en <b>este navegador</b>. Para publicarlo, usa <b>Exportar JSON</b> o pídele a Neura que conecte las páginas al contenido. Ver <a href="#" onclick="openPublish();return false">Cómo publicar</a>.</p></div>`;
  c.innerHTML=html;
}
/* ============================ IMÁGENES (subida real vía upload.php) ============================ */
const UPLOAD_URL = '/upload.php';
const UPLOAD_TOKEN = 'pm_up_9Fk27Rd4Qz';   // <-- debe coincidir con upload.php
const IMAGE_SLOTS = [
  { slot:'hero-cover',    def:'/hero-cover.jpg',    nm:'Portada del Home', wh:'Home · imagen de portada' },
  { slot:'face',          def:'/face.jpg',          nm:'Foto principal',   wh:'Home + Nosotros' },
  { slot:'hero-machinery',def:'/hero-machinery.jpg',nm:'Fondo Nosotros',   wh:'Página Nosotros' },
  { slot:'tech-monitors', def:'/tech-monitors.jpg', nm:'Fondo Servicios',  wh:'Servicios + Home' },
  { slot:'aerial-right',  def:'/aerial-right.jpg',  nm:'Franja CTA',       wh:'Home · franja inferior' },
  { slot:'logo-full',     def:'/logo-full.png',     nm:'Logo',             wh:'Menú + Footer', logo:true },
];
function renderImages(c){
  c.innerHTML = `<div class="card" style="border-color:rgba(222,105,78,.3);background:#FCF3F0">
      <h3>▣ Imágenes del sitio</h3>
      <p class="hint" style="margin:0 0 14px;line-height:1.6;color:var(--muted)">Acá <b>reemplazás</b> las imágenes fijas del sitio (portada, foto, fondos, logo). Elegí una nueva y se sube al servidor — el sitio en vivo la muestra en unos segundos. JPG, PNG o WEBP · máx. 8 MB. Si no ves el cambio al instante, recargá con <b>Ctrl + F5</b>.</p>
      <div style="padding-top:12px;border-top:1px solid rgba(222,105,78,.25)">
        <p class="hint" style="margin:0 0 10px;color:var(--muted)">¿Querés <b>subir una foto nueva</b> sin reemplazar ninguna de estas? Usá la Galería:</p>
        <button class="btn primary" onclick="go('gallery')">▤ Ir a Galería · subir fotos nuevas</button>
      </div>
    </div>
    <div class="grid imgrid" id="imgrid"></div>`;
  document.getElementById('imgrid').innerHTML = IMAGE_SLOTS.map(s => `
    <div class="imgcard" id="ic-${s.slot}">
      <div class="thumb${s.logo?' logo':''}" id="th-${s.slot}" style="background-image:url('${s.def}')">
        <span class="imgbadge" id="bd-${s.slot}" style="display:none">Personalizada</span>
      </div>
      <div class="body">
        <p class="nm">${s.nm}</p><p class="wh">${s.wh}</p>
        <button class="btn accent sm" onclick="imgPick('${s.slot}')">Cambiar imagen</button>
        <div class="st" id="st-${s.slot}"></div>
      </div>
    </div>`).join('');
  // marcar las que ya tienen una versión subida (lee el manifest vía health-check)
  fetch(UPLOAD_URL, { cache:'no-store' }).then(r=>r.json()).then(res=>{
    const m = res && res.manifest ? res.manifest : {};
    IMAGE_SLOTS.forEach(s=>{ if(m[s.slot]){ setThumb(s.slot,'/uploads/site/'+m[s.slot]); showBadge(s.slot); } });
  }).catch(()=>{});
}
function setThumb(slot,url){ document.getElementById('th-'+slot).style.backgroundImage=`url('${url}')`; }
function showBadge(slot){ const b=document.getElementById('bd-'+slot); if(b) b.style.display=''; }
function imgPick(slot){
  const inp=document.createElement('input'); inp.type='file'; inp.accept='image/jpeg,image/png,image/webp';
  inp.onchange=()=>{ const f=inp.files&&inp.files[0]; if(f) imgUpload(slot,f); };
  inp.click();
}
function imgUpload(slot,file){
  const st=document.getElementById('st-'+slot), card=document.getElementById('ic-'+slot);
  if(!/^image\/(jpeg|png|webp)$/.test(file.type)){ st.className='st err'; st.textContent='Formato no válido (usá JPG, PNG o WEBP).'; return; }
  if(file.size>8*1024*1024){ st.className='st err'; st.textContent='Muy pesada (máx. 8 MB).'; return; }
  try{ setThumb(slot,URL.createObjectURL(file)); }catch(e){}   // vista previa inmediata
  st.className='st busy'; st.textContent='Subiendo…'; card.classList.add('up');
  const fd=new FormData(); fd.append('token',UPLOAD_TOKEN); fd.append('slot',slot); fd.append('image',file);
  fetch(UPLOAD_URL,{method:'POST',body:fd}).then(r=>r.json()).then(res=>{
    card.classList.remove('up');
    if(res&&res.ok){
      setThumb(slot,'/uploads/site/'+res.file); showBadge(slot);
      st.className='st ok'; st.textContent='✓ Actualizada. Recargá el sitio (Ctrl+F5) si no la ves.';
      toast('✓ Imagen actualizada');
    } else {
      st.className='st err'; st.textContent='Error: '+((res&&res.error)||'desconocido')+'. Verificá que upload.php esté subido.';
    }
  }).catch(()=>{ card.classList.remove('up'); st.className='st err'; st.textContent='No se pudo conectar con upload.php (¿ya está en el servidor?).'; });
}
/* ============================ GALERÍA — fuente única: api/gallery.php ============================
   Lista TODAS las imágenes (base + subidas), editá título/descripción/alt/categoría,
   mostrá u ocultá, reordená arrastrando y eliminá. Lo mismo que ve la web pública. */
let galData   = { categories: [], images: [] };
let galFilter = 'all';
let galQuery  = '';
let galDrag   = null;

function galCatName(slug){ const c=(galData.categories||[]).find(x=>x.slug===slug); return c?(c.es||c.slug):slug; }
function galStatus(msg,isErr){ const s=document.getElementById('galStatus'); if(s){ s.style.color=isErr?'var(--err)':'var(--muted)'; s.textContent=msg||''; } }

function renderGallery(c){
  c.innerHTML = `<div class="card" style="border-color:rgba(222,105,78,.3);background:#FCF3F0">
      <h3>▤ Galería del sitio</h3>
      <p class="hint" style="margin:0 0 14px;line-height:1.6;color:var(--muted)">Esta es <b>la misma galería</b> que se ve en el inicio y en la página <b>Galería</b>. Acá ves <b>todas</b> las fotos (las base y las que subís), podés <b>editarlas</b>, <b>ocultarlas</b>, <b>reordenarlas</b> y <b>eliminarlas</b>. Los cambios aparecen en la web al instante. JPG, PNG, WEBP o AVIF · máx. 25 MB.</p>
      <div class="galrow">
        <select id="galUpCat" style="max-width:320px"></select>
        <button class="btn accent" onclick="galAddPick()">+ Agregar fotos</button>
        <span id="galStatus" class="hint"></span>
      </div>
      <div class="galrow" style="margin-top:12px;padding-top:12px;border-top:1px solid rgba(222,105,78,.25)">
        <input id="galSearch" type="text" placeholder="Buscar por título, descripción o texto alternativo…" style="max-width:340px;flex:1" oninput="galQuery=this.value.trim().toLowerCase();galRenderGrid()">
        <select id="galFilter" style="max-width:280px" onchange="galFilter=this.value;galRenderGrid()"></select>
        <span id="galCount" class="hint"></span>
      </div>
      <p id="galReorderHint" class="hint" style="margin:10px 0 0;color:var(--dim)">↕ Arrastrá las fotos para cambiar el orden. El reordenamiento está disponible cuando no hay filtro ni búsqueda activa.</p>
    </div>
    <div id="galgrid"><p class="hint">Cargando galería…</p></div>`;
  galLoad();
}

function galLoad(){
  const bust = '?t=' + Date.now();
  const readFallback = () =>
    fetch('/data/gallery.json' + bust, { cache:'no-store' }).then(r=>{ if(!r.ok) throw 0; return r.json(); })
      .catch(()=> fetch('/data/gallery.seed.json' + bust, { cache:'no-store' }).then(r=>r.json()));
  fetch(GAL_API + bust, { cache:'no-store', credentials:'same-origin' })
    .then(r=>{ if(!r.ok) throw 0; return r.json(); })
    .catch(readFallback)
    .then(d=>{
      galData = { categories:(d&&d.categories)||[], images:(d&&d.images)||[] };
      galFillSelects();
      galRenderGrid();
    })
    .catch(()=>{ const g=document.getElementById('galgrid'); if(g) g.innerHTML='<p class="hint" style="color:var(--err)">No se pudo cargar la galería. Verificá que el servidor esté disponible.</p>'; });
}

function galFillSelects(){
  const cats = galData.categories || [];
  const up = document.getElementById('galUpCat');
  if(up) up.innerHTML = cats.map(x=>`<option value="${esc(x.slug)}">${esc(x.es||x.slug)}</option>`).join('') || '<option value="">(sin categorías)</option>';
  const fl = document.getElementById('galFilter');
  if(fl){ fl.innerHTML = '<option value="all">Todas las categorías</option>' + cats.map(x=>`<option value="${esc(x.slug)}">${esc(x.es||x.slug)}</option>`).join(''); fl.value = galFilter; }
}

function galRenderGrid(){
  const g = document.getElementById('galgrid'); if(!g) return;
  let imgs = (galData.images||[]).slice().sort((a,b)=>(a.sort_order||0)-(b.sort_order||0));
  const total = imgs.length;
  if(galFilter!=='all') imgs = imgs.filter(i=>i.category===galFilter);
  if(galQuery) imgs = imgs.filter(i=>((i.title||'')+' '+(i.alt||'')+' '+(i.description||'')+' '+(i.id||'')).toLowerCase().includes(galQuery));
  const cnt = document.getElementById('galCount'); if(cnt) cnt.textContent = imgs.length + (imgs.length===total?'':(' de '+total)) + ' foto(s)';
  const reorder = (galFilter==='all' && !galQuery);
  const hint = document.getElementById('galReorderHint'); if(hint) hint.style.opacity = reorder ? '1' : '.4';
  if(!imgs.length){ g.innerHTML = '<p class="hint">No hay fotos que coincidan con la búsqueda o el filtro.</p>'; return; }
  g.innerHTML = '<div class="grid imgrid" id="galinner"></div>';
  const inner = document.getElementById('galinner');
  inner.innerHTML = imgs.map(im=>galCard(im,reorder)).join('');
  if(reorder) galBindDnd(inner);
}

function galCard(im,reorder){
  const id = esc(im.id||'');
  const thumb = esc(im.thumbnail || im.src || '');
  const active = im.active !== false;
  const opts = (galData.categories||[]).map(x=>`<option value="${esc(x.slug)}"${x.slug===im.category?' selected':''}>${esc(x.es||x.slug)}</option>`).join('');
  return `<div class="imgcard galcard${active?'':' hidden'}" data-id="${id}"${reorder?' draggable="true"':''}>
    <div class="thumb" style="background-image:url('/${thumb}')" title="${id}">
      ${im.protected?'<span class="imgbadge">Base</span>':''}
      ${active?'':'<span class="imgbadge" style="left:auto;right:8px;background:var(--err)">Oculta</span>'}
    </div>
    <div class="body">
      <input class="galf" value="${esc(im.title||'')}" placeholder="Título" onchange="galSave('${id}','title',this.value)">
      <div class="galrow" style="gap:8px;margin-top:6px;flex-wrap:nowrap">
        <select class="galf" style="flex:1;min-width:0" onchange="galSave('${id}','category',this.value,true)">${opts}</select>
        <label class="galchk"><input type="checkbox"${active?' checked':''} onchange="galSave('${id}','active',this.checked?'1':'0',true)"> Visible</label>
      </div>
      <div class="galedit" style="display:none;margin-top:8px">
        <textarea class="galf" placeholder="Descripción" onchange="galSave('${id}','description',this.value)">${esc(im.description||'')}</textarea>
        <input class="galf" style="margin-top:6px" placeholder="Texto alternativo (alt)" value="${esc(im.alt||'')}" onchange="galSave('${id}','alt',this.value)">
      </div>
      <div class="galrow" style="justify-content:space-between;margin-top:8px">
        <button class="btn ghost sm" onclick="galToggleEdit(this)">✎ Textos</button>
        <button class="btn ghost sm danger" onclick="galDelete('${id}')">Eliminar</button>
      </div>
    </div>
  </div>`;
}

function galToggleEdit(btn){ const p=btn.closest('.body').querySelector('.galedit'); if(p) p.style.display = (p.style.display==='none'?'':'none'); }

function galSave(id, field, value, reRender){
  galStatus('Guardando…');
  const fd=new FormData(); fd.append('action','update'); fd.append('id',id); fd.append(field,value);
  fetch(GAL_API,{method:'POST',body:fd,credentials:'same-origin'}).then(r=>r.json()).then(res=>{
    if(res && res.ok){
      galData={ categories:res.categories||galData.categories, images:res.images||galData.images };
      galStatus('✓ Cambios guardados');
      if(reRender) galRenderGrid();
    } else if(res && res.error==='auth'){ galStatus('Tu sesión expiró. Cerrá sesión y volvé a entrar.', true); }
    else galStatus('No se pudo guardar: '+((res&&res.error)||'error desconocido'), true);
  }).catch(()=>galStatus('Sin conexión con el servidor.', true));
}

function galAddPick(){
  const sel=document.getElementById('galUpCat'); const cat=sel?sel.value:'';
  if(!cat){ galStatus('No hay categoría seleccionada.', true); return; }
  const inp=document.createElement('input'); inp.type='file'; inp.accept='image/jpeg,image/png,image/webp,image/avif'; inp.multiple=true;
  inp.onchange=()=>{ const files=[...(inp.files||[])]; if(files.length) galUploadSeq(cat, files, files.length); };
  inp.click();
}
function galUploadSeq(cat,files,total,res){
  res=res||{ok:0,skip:0,err:0,msg:''};
  if(!files.length){
    let m='✓ '+res.ok+' foto(s) subida(s)';
    if(res.skip) m+=' · '+res.skip+' omitida(s) (no es imagen válida o pesa más de 25 MB)';
    if(res.err)  m+=' · '+res.err+' con error'+(res.msg?(': '+res.msg):'');
    galStatus(m, !res.ok && (res.err>0||res.skip>0));
    toast(res.ok?('✓ '+res.ok+' foto(s) agregada(s)'):'⚠ No se agregó ninguna foto');
    galLoad(); return;
  }
  const done=total-files.length+1;
  galStatus('Subiendo '+done+'/'+total+' a “'+galCatName(cat)+'”…');
  const file=files.shift();
  if(!/^image\/(jpeg|png|webp|avif)$/.test(file.type) || file.size>25*1024*1024){ res.skip++; galUploadSeq(cat,files,total,res); return; }
  const fd=new FormData(); fd.append('action','upload'); fd.append('category',cat); fd.append('image',file);
  fetch(GAL_API,{method:'POST',body:fd,credentials:'same-origin'}).then(r=>r.json())
    .then(j=>{ if(j&&j.ok) res.ok++; else { res.err++; res.msg=(j&&j.error==='auth')?'sesión expirada':((j&&j.error)||'rechazado'); } galUploadSeq(cat,files,total,res); })
    .catch(()=>{ res.err++; res.msg='sin conexión'; galUploadSeq(cat,files,total,res); });
}

function galDelete(id){
  const im=(galData.images||[]).find(x=>x.id===id);
  const nm=im&&im.title?('“'+im.title+'”'):'esta foto';
  if(!confirm('¿Eliminar '+nm+' de la galería?\nEsta acción no se puede deshacer.')) return;
  galStatus('Eliminando…');
  const fd=new FormData(); fd.append('action','delete'); fd.append('id',id);
  fetch(GAL_API,{method:'POST',body:fd,credentials:'same-origin'}).then(r=>r.json()).then(res=>{
    if(res && res.ok){
      galData={ categories:res.categories||galData.categories, images:res.images||galData.images };
      galRenderGrid(); galStatus('✓ Foto eliminada'); toast('✓ Foto eliminada');
    } else if(res && res.error==='auth'){ galStatus('Tu sesión expiró. Cerrá sesión y volvé a entrar.', true); }
    else galStatus('No se pudo eliminar: '+((res&&res.error)||'error desconocido'), true);
  }).catch(()=>galStatus('Sin conexión con el servidor.', true));
}

/* ---- Reordenar arrastrando (drag & drop) ---- */
function galBindDnd(grid){
  grid.querySelectorAll('.galcard').forEach(card=>{
    card.addEventListener('dragstart',()=>{ galDrag=card; card.classList.add('dragging'); });
    card.addEventListener('dragend',()=>{ card.classList.remove('dragging'); galDrag=null; galCommitOrder(); });
  });
  grid.addEventListener('dragover',e=>{
    e.preventDefault(); if(!galDrag) return;
    const after=galGetAfter(grid,e.clientX,e.clientY);
    if(after==null) grid.appendChild(galDrag); else grid.insertBefore(galDrag,after);
  });
}
function galGetAfter(grid,x,y){
  const els=[...grid.querySelectorAll('.galcard:not(.dragging)')];
  let closest={off:Number.NEGATIVE_INFINITY, el:null};
  for(const el of els){
    const b=el.getBoundingClientRect();
    const off=(y-(b.top+b.height/2))*1e6 + (x-(b.left+b.width/2)); // row-major: <0 si el puntero está antes del centro
    if(off<0 && off>closest.off) closest={off, el};
  }
  return closest.el;
}
function galCommitOrder(){
  const inner=document.getElementById('galinner'); if(!inner) return;
  const ids=[...inner.querySelectorAll('.galcard')].map(el=>el.dataset.id);
  galStatus('Guardando el nuevo orden…');
  const fd=new FormData(); fd.append('action','reorder'); fd.append('order',JSON.stringify(ids));
  fetch(GAL_API,{method:'POST',body:fd,credentials:'same-origin'}).then(r=>r.json()).then(res=>{
    if(res && res.ok){ galData={ categories:res.categories||galData.categories, images:res.images||galData.images }; galStatus('✓ Orden guardado'); }
    else if(res && res.error==='auth'){ galStatus('Tu sesión expiró. Cerrá sesión y volvé a entrar.', true); }
    else galStatus('No se pudo guardar el orden: '+((res&&res.error)||'error'), true);
  }).catch(()=>galStatus('Sin conexión con el servidor.', true));
}
function inputFor(f,path,val){
  const flag=f.i18n?`<span class="flag mono">${lang.toUpperCase()}</span>`:'';
  if(f.type==='textarea') return `<div class="field"><label>${f.label}${flag}</label><textarea data-path="${path}" oninput="onEdit(this)">${esc(val)}</textarea></div>`;
  if(f.type==='chips') return `<div class="field"><label>${f.label}${flag}</label>${chipsFor(path,val||[])}</div>`;
  return `<div class="field"><label>${f.label}${flag}</label><input type="text" data-path="${path}" value="${esc(val)}" oninput="onEdit(this)"></div>`;
}
function chipsFor(path,arr){
  let html=`<div class="chips-input" data-chips="${path}">`;
  arr.forEach((v,i)=>html+=`<span class="chip">${esc(v)}<button onclick="removeChip('${path}',${i})">×</button></span>`);
  html+=`<input type="text" placeholder="Añadir y Enter" onkeydown="if(event.key==='Enter'){addChip('${path}',this.value);this.value='';event.preventDefault();}"></div>`;
  return html;
}
function fieldKey(f){ return f.i18n?f.key+'_'+lang:f.key; }
function renderObject(c,s){
  let html=`<div class="card"><h3>${s.title}</h3><p class="hint">${s.sub}</p>`;
  s.fields.forEach(f=>{ const k=fieldKey(f); html+=inputFor(f,s.id+'.'+k,draft[s.id][k]); });
  html+=`</div>`; c.innerHTML=html;
}
function renderList(c,s){
  const arr=draft[s.id];
  let html=`<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px"><p class="hint" style="margin:0">${arr.length} elemento(s)</p><button class="btn accent sm" onclick="addItem('${s.id}')">+ Añadir</button></div>`;
  arr.forEach((it,i)=>{
    html+=`<div class="item"><div class="ihead"><span class="mono idx">#${String(i+1).padStart(2,'0')}</span><div style="display:flex;gap:6px">
      <button class="btn ghost sm" onclick="moveItem('${s.id}',${i},-1)" ${i===0?'disabled style=opacity:.3':''}>↑</button>
      <button class="btn ghost sm" onclick="moveItem('${s.id}',${i},1)" ${i===arr.length-1?'disabled style=opacity:.3':''}>↓</button>
      <button class="btn ghost sm danger" onclick="delItem('${s.id}',${i})">Eliminar</button></div></div>`;
    s.item.forEach(f=>{ const k=fieldKey(f); html+=inputFor(f,`${s.id}.${i}.${k}`,it[k]); });
    html+=`</div>`;
  });
  c.innerHTML=html;
}
function setPath(path,value){ const p=path.split('.'); let o=draft; for(let i=0;i<p.length-1;i++)o=o[p[i]]; o[p[p.length-1]]=value; markDirty(); }
function getPath(path){ return path.split('.').reduce((o,k)=>o&&o[k],draft); }
function onEdit(el){ setPath(el.getAttribute('data-path'),el.value); }
function addChip(path,val){ val=(val||'').trim(); if(!val)return; const a=getPath(path)||[]; a.push(val); setPath(path,a); refresh(); }
function removeChip(path,i){ const a=getPath(path)||[]; a.splice(i,1); setPath(path,a); refresh(); }
function emptyItem(s){ const o={}; s.item.forEach(f=>{ if(f.i18n){ if(f.type==='chips'){o[f.key+'_pt']=[];o[f.key+'_es']=[];} else {o[f.key+'_pt']='';o[f.key+'_es']='';} } else { o[f.key]=f.type==='chips'?[]:''; } }); return o; }
function addItem(id){ const s=SCHEMA.find(x=>x.id===id); draft[id].push(emptyItem(s)); markDirty(); go(id); }
function delItem(id,i){ if(!confirm('¿Eliminar este elemento?'))return; draft[id].splice(i,1); markDirty(); go(id); }
function moveItem(id,i,dir){ const a=draft[id],j=i+dir; if(j<0||j>=a.length)return; [a[i],a[j]]=[a[j],a[i]]; markDirty(); go(id); }
function refresh(){ if(current!=='dashboard') go(current); }
function markDirty(){ dirty=true; document.getElementById('savebar').classList.add('show'); }
function saveAll(){ persist(); dirty=false; document.getElementById('savebar').classList.remove('show'); toast('✓ Cambios guardados'); if(current==='dashboard') renderDashboard(document.getElementById('content')); }
function discardChanges(){ draft=clone(data); dirty=false; document.getElementById('savebar').classList.remove('show'); go(current); toast('Cambios descartados'); }
function doExport(){ const blob=new Blob([JSON.stringify(draft,null,2)],{type:'application/json'}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download='content.json'; a.click(); URL.revokeObjectURL(url); toast('↧ content.json exportado'); }
function doImport(e){ const file=e.target.files[0]; if(!file)return; const r=new FileReader(); r.onload=()=>{ try{ const obj=JSON.parse(r.result); draft=Object.assign(clone(DEFAULT),obj); persist(); dirty=false; document.getElementById('savebar').classList.remove('show'); go('dashboard'); toast('↥ Contenido importado'); }catch(err){ alert('Archivo inválido.'); } }; r.readAsText(file); e.target.value=''; }
function doReset(){ if(!confirm('¿Restaurar todo el contenido a los valores originales?'))return; draft=clone(DEFAULT); persist(); dirty=false; document.getElementById('savebar').classList.remove('show'); go('dashboard'); toast('⟲ Contenido restaurado'); }
function openPublish(){ document.getElementById('publishModal').classList.add('show'); }
function closePublish(){ document.getElementById('publishModal').classList.remove('show'); }
function toast(msg){ const t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove('show'),2200); }
window.addEventListener('beforeunload',(e)=>{ if(dirty){ e.preventDefault(); e.returnValue=''; } });

if(sessionStorage.getItem('promin_admin_ok')==='1'){ showApp(); }
else { document.getElementById('email').focus(); }
</script>
</body>
</html>
